# Edge Function gizli anahtarları. Bu dosyayı kopyalayıp `.env` yap ve doldur
# (.env commit edilmez). Canlı projeye göndermek için:
#   npx supabase secrets set --env-file supabase/functions/.env
#
# Cloudflare panel › R2 › Manage API tokens (Object Read & Write, yalnızca bu bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bungalovum-photos
# Bucket › Settings › Public Development URL (https://pub-xxxx.r2.dev)
# ya da bağlanan özel alan adı (https://cdn.alanadin.com)
R2_PUBLIC_URL=
